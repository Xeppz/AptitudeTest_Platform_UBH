# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: only enforced when set. Protects /api/cron/keep-alive from being
# triggered by anyone but Vercel Cron. Leave blank for local dev.
CRON_SECRET=
